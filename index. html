<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />
  <title>Free meowie Mini App</title>

  <style>
    :root {
      --border: rgba(255, 255, 255, 0.12);
      --text: #f5f8ff;
      --muted: #bfd4ff;
      --button: linear-gradient(135deg, #51a7ff 0%, #88dbff 100%);
      --shadow: 0 15px 45px rgba(5, 13, 42, 0.45);
      --radius: 28px;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: Tahoma, "Segoe UI", sans-serif;
      background: #082658;
      color: var(--text);
      -webkit-tap-highlight-color: transparent;
    }

    body {
      position: relative;
    }

    /* آسمان آبی با عمق و نور ملایم */
    .app {
      position: relative;
      width: 100%;
      height: 100dvh;
      overflow: hidden;
      isolation: isolate;
      background:
        radial-gradient(
          ellipse at 50% -10%,
          rgba(75, 157, 255, 0.48),
          transparent 62%
        ),
        radial-gradient(
          ellipse at 100% 45%,
          rgba(35, 112, 226, 0.18),
          transparent 58%
        ),
        radial-gradient(
          ellipse at 0% 75%,
          rgba(30, 99, 200, 0.14),
          transparent 55%
        ),
        linear-gradient(
          180deg,
          #164d9c 0%,
          #0b316d 48%,
          #071d43 100%
        );
    }

    /* روشنایی آرام در عمق پس‌زمینه */
    .app::before {
      content: "";
      position: absolute;
      inset: -10%;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(
          ellipse at 28% 22%,
          rgba(103, 185, 255, 0.14),
          transparent 48%
        ),
        radial-gradient(
          ellipse at 76% 65%,
          rgba(63, 123, 241, 0.1),
          transparent 50%
        );
      animation: skyDrift 24s ease-in-out infinite alternate;
    }

    .stars,
    .meteors {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .stars::before,
    .stars::after {
      content: "";
      position: absolute;
      inset: 0;
      background-repeat: repeat;
    }

    /* ستاره‌های دور و ریز */
    .stars::before {
      background-image:
        radial-gradient(
          circle,
          rgba(233, 245, 255, 0.8) 0 0.7px,
          transparent 1.3px
        ),
        radial-gradient(
          circle,
          rgba(161, 207, 255, 0.65) 0 0.6px,
          transparent 1.2px
        ),
        radial-gradient(
          circle,
          rgba(211, 232, 255, 0.5) 0 0.5px,
          transparent 1.1px
        );
      background-size:
        193px 211px,
        293px 307px,
        137px 173px;
      background-position:
        24px 43px,
        108px 127px,
        67px 92px;
      opacity: 0.65;
    }

    /* تعداد کمی ستاره روشن‌تر، بدون چشمک تند */
    .stars::after {
      background-image:
        radial-gradient(
          circle,
          rgba(235, 248, 255, 0.9) 0 0.9px,
          rgba(145, 205, 255, 0.15) 1.4px,
          transparent 3px
        ),
        radial-gradient(
          circle,
          rgba(185, 220, 255, 0.7) 0 0.7px,
          transparent 1.8px
        );
      background-size: 379px 397px, 457px 433px;
      background-position: 88px 73px, 213px 187px;
      opacity: 0.55;
      animation: starBreathing 11s ease-in-out infinite alternate;
    }

    /*
      سر شهاب در ابتدای خط قرار دارد.
      دنباله به سمت بالا و راست است و حرکت به پایین و چپ.
    */
    .meteor {
      position: absolute;
      left: var(--start-x);
      top: var(--start-y);
      width: var(--tail);
      height: 1px;
      border-radius: 999px;
      opacity: 0;
      transform-origin: left center;
      background: linear-gradient(
        90deg,
        rgba(245, 252, 255, 0.98) 0%,
        rgba(185, 226, 255, 0.8) 8%,
        rgba(111, 183, 255, 0.35) 36%,
        rgba(85, 158, 247, 0.08) 72%,
        transparent 100%
      );
      filter: drop-shadow(0 0 3px rgba(123, 194, 255, 0.4));
      animation:
        meteorPass var(--duration) linear var(--delay) infinite;
    }

    /* هسته کوچک و طبیعی */
    .meteor::before {
      content: "";
      position: absolute;
      left: -1px;
      top: 50%;
      width: 2.5px;
      height: 2.5px;
      border-radius: 50%;
      transform: translateY(-50%);
      background: #f2fbff;
      box-shadow:
        0 0 5px rgba(207, 238, 255, 0.8),
        0 0 11px rgba(116, 194, 255, 0.35);
    }

    /* هاله ظریف اطراف دنباله */
    .meteor::after {
      content: "";
      position: absolute;
      inset: -2px 0;
      border-radius: inherit;
      background: inherit;
      filter: blur(3px);
      opacity: 0.35;
    }

    .screen {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 20px;
      transition: opacity 0.35s ease, transform 0.35s ease;
    }

    .hidden {
      opacity: 0;
      pointer-events: none;
      transform: translateY(18px);
    }

    .hidden .meteor,
    .hidden .stars::after {
      animation-play-state: paused;
    }

    .header-title {
      position: absolute;
      top: max(16px, env(safe-area-inset-top));
      right: 16px;
      z-index: 3;
      padding: 10px 14px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 999px;
      background: rgba(7, 16, 45, 0.3);
      backdrop-filter: blur(10px);
      font-size: 14px;
      font-weight: 700;
      color: #ebf5ff;
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
    }

    .card {
      width: min(92vw, 760px);
      padding: 28px 22px;
      border-radius: var(--radius);
      background: linear-gradient(
        180deg,
        rgba(7, 19, 51, 0.58),
        rgba(4, 12, 35, 0.82)
      );
      border: 1px solid var(--border);
      backdrop-filter: blur(14px);
      box-shadow: var(--shadow);
      text-align: center;
      position: relative;
      z-index: 2;
    }

    .glow {
      position: absolute;
      inset: -30px;
      z-index: 1;
      background: radial-gradient(
        ellipse at center,
        rgba(96, 181, 255, 0.1),
        transparent 65%
      );
      filter: blur(14px);
      pointer-events: none;
    }

    .headline {
      margin: 0 0 18px;
      font-size: clamp(24px, 4vw, 36px);
      line-height: 1.8;
      font-weight: 800;
      text-wrap: balance;
    }

    .subtext {
      margin: 0 auto 24px;
      max-width: 600px;
      color: var(--muted);
      font-size: 15px;
      line-height: 2;
    }

    .primary-btn,
    .back-btn {
      border: 0;
      outline: 0;
      cursor: pointer;
      border-radius: 18px;
      padding: 14px 22px;
      font-size: 15px;
      font-weight: 800;
      transition:
        transform 0.18s ease,
        box-shadow 0.25s ease,
        opacity 0.2s ease;
    }

    .primary-btn {
      color: #062045;
      background: var(--button);
      box-shadow: 0 10px 28px rgba(104, 198, 255, 0.35);
    }

    .back-btn {
      color: #eef6ff;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      backdrop-filter: blur(10px);
    }

    .primary-btn:active,
    .back-btn:active {
      transform: scale(0.97);
    }

    .details-wrapper {
      width: min(94vw, 820px);
      max-height: calc(100dvh - 40px);
      overflow: auto;
      padding: 18px;
      border-radius: 28px;
      background: linear-gradient(
        180deg,
        rgba(5, 14, 38, 0.78),
        rgba(4, 11, 28, 0.96)
      );
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: var(--shadow);
      backdrop-filter: blur(15px);
      position: relative;
      z-index: 2;
      scrollbar-width: thin;
      scrollbar-color: rgba(152, 216, 255, 0.6) transparent;
    }

    .details-wrapper::-webkit-scrollbar {
      width: 8px;
    }

    .details-wrapper::-webkit-scrollbar-thumb {
      background: rgba(152, 216, 255, 0.5);
      border-radius: 999px;
    }

    .details-title {
      margin: 12px 0 18px;
      text-align: center;
      font-size: clamp(22px, 4vw, 32px);
      line-height: 1.7;
      font-weight: 900;
      color: #f5fbff;
    }

    .details-body {
      color: #d8e8ff;
      line-height: 2.2;
      font-size: 15px;
      white-space: pre-line;
      text-align: right;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 22px;
      padding: 18px 16px;
      margin-bottom: 16px;
    }

    .actions {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      padding: 4px 0 6px;
    }

    .details-stars {
      opacity: 0.75;
    }

    .footer-note {
      margin-top: 12px;
      font-size: 13px;
      color: rgba(232, 242, 255, 0.82);
    }

    @keyframes skyDrift {
      from {
        transform: translate3d(-8px, -6px, 0) scale(1);
      }
      to {
        transform: translate3d(8px, 10px, 0) scale(1.035);
      }
    }

    @keyframes starBreathing {
      from { opacity: 0.4; }
      to { opacity: 0.65; }
    }

    /*
      عبور شهاب در ابتدای هر چرخه انجام می‌شود.
      باقی زمان، آسمان خلوت می‌ماند.
    */
    @keyframes meteorPass {
      0% {
        opacity: 0;
        transform: translate3d(0, 0, 0) rotate(-32deg);
      }

      4% {
        opacity: 0.85;
      }

      18% {
        opacity: 0.65;
      }

      32% {
        opacity: 0;
        transform:
          translate3d(var(--travel-x), var(--travel-y), 0)
          rotate(-32deg);
      }

      100% {
        opacity: 0;
        transform:
          translate3d(var(--travel-x), var(--travel-y), 0)
          rotate(-32deg);
      }
    }

    @media (max-width: 640px) {
      .card {
        padding: 24px 18px;
      }

      .details-wrapper {
        max-height: calc(100dvh - 24px);
        padding: 14px;
      }

      .details-body {
        font-size: 14px;
        line-height: 2.15;
      }

      .primary-btn,
      .back-btn {
        width: 100%;
      }

      .actions {
        flex-direction: column;
      }

      .header-title {
        font-size: 13px;
        left: 16px;
        right: 16px;
        text-align: center;
      }

      .meteor {
        width: calc(var(--tail) * 0.75);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .app::before,
      .stars::after,
      .meteor {
        animation: none;
      }

      .meteor {
        opacity: 0;
      }
    }
  </style>
</head>

<body>
  <main class="app">
    <section class="screen" id="homeScreen">
      <div class="stars" aria-hidden="true"></div>
