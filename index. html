  <script src="https://telegram.org/js/telegram-web-app.js"></script>

  <script>
    const homeScreen = document.getElementById('homeScreen');
    const detailsScreen = document.getElementById('detailsScreen');
    const whyBtn = document.getElementById('whyBtn');
    const backBtn = document.getElementById('backBtn');
    const meteorLayer = document.getElementById('meteorLayer');

    function updateMeteorPaths() {
      const width = meteorLayer.clientWidth;
      const height = meteorLayer.clientHeight;
      const distance = Math.max(width * 0.88, height * 0.8);
      const verticalDistance = distance * Math.tan(32 * Math.PI / 180);

      meteorLayer.style.setProperty('--travel-x', `${-distance}px`);
      meteorLayer.style.setProperty('--travel-y', `${verticalDistance}px`);
    }

    function createMeteors() {
      const configs = [
        { x: 108, y: 6,  tail: 145, duration: 13.5, delay: -1.2 },
        { x: 72,  y: -6, tail: 110, duration: 17.8, delay: -8.5 },
        { x: 112, y: 35, tail: 155, duration: 21.4, delay: -14.0 },
        { x: 44,  y: -8, tail: 95,  duration: 16.2, delay: -10.7 },
        { x: 94,  y: 12, tail: 125, duration: 24.6, delay: -5.8 }
      ];

      const fragment = document.createDocumentFragment();

      configs.forEach(config => {
        const meteor = document.createElement('span');
        meteor.className = 'meteor';

        meteor.style.setProperty('--start-x', `${config.x}%`);
        meteor.style.setProperty('--start-y', `${config.y}%`);
        meteor.style.setProperty('--tail', `${config.tail}px`);
        meteor.style.setProperty('--duration', `${config.duration}s`);
        meteor.style.setProperty('--delay', `${config.delay}s`);

        fragment.appendChild(meteor);
      });

      meteorLayer.replaceChildren(fragment);
      updateMeteorPaths();
    }

    function showDetails() {
      homeScreen.classList.add('hidden');
      detailsScreen.classList.remove('hidden');

      if (window.Telegram && Telegram.WebApp && Telegram.WebApp.BackButton) {
        Telegram.WebApp.BackButton.show();
      }
    }

    function showHome() {
      detailsScreen.classList.add('hidden');
      homeScreen.classList.remove('hidden');

      if (window.Telegram && Telegram.WebApp && Telegram.WebApp.BackButton) {
        Telegram.WebApp.BackButton.hide();
      }
    }

    whyBtn.addEventListener('click', showDetails);
    backBtn.addEventListener('click', showHome);

    if (window.Telegram && Telegram.WebApp) {
      Telegram.WebApp.ready();
      Telegram.WebApp.expand();

      if (Telegram.WebApp.BackButton) {
        Telegram.WebApp.BackButton.onClick(showHome);
        Telegram.WebApp.BackButton.hide();
      }
    }

    createMeteors();

    if ('ResizeObserver' in window) {
      const meteorResizeObserver = new ResizeObserver(updateMeteorPaths);
      meteorResizeObserver.observe(meteorLayer);
    } else {
      window.addEventListener('resize', updateMeteorPaths);
    }
  </script>
</body>
</html>
